// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Propiedad {
  id                Int      @id @default(autoincrement())
  titulo            String
  descripcion       String
  tipo              String   // casa, terreno, local, piso
  precio            Float
  ubicacion         String
  municipio         String
  habitaciones      Int?
  banos             Int?
  superficie        Float    // m2
  superficieParcela Float?
  estado            String   @default("disponible") // disponible, reservada, vendida
  destacada         Boolean  @default(false)
  imagenes          String   // JSON array of image paths
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contacto {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String
  telefono    String?
  mensaje     String
  propiedadId Int?
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Encargo {
  id         Int      @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String
  municipio  String
  direccion  String?
  tipo       String   // casa, terreno, local, piso
  precio     Float
  superficie Float?
  descripcion String?
  estado     String   @default("pendiente") // pendiente, en_gestion, publicada, descartada
  notas      String?  // notas internas del admin
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
